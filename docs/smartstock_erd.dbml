// SmartStock ERD, Laravel version (matches src/database/migrations)
// Differences from the first ERD: primary keys are named `id` (Laravel convention),
// users.full_name -> users.name, users.password_hash -> users.password,
// and Laravel adds created_at / updated_at to most tables.
// Laravel also creates its own tables (sessions, cache, jobs, password_reset_tokens), not shown here.

Table roles {
  id bigint [pk, increment]
  role_name varchar(50) [not null, unique]
  created_at timestamp
  updated_at timestamp
}

Table users {
  id bigint [pk, increment]
  role_id bigint [not null]
  name varchar(255) [not null]
  email varchar(255) [not null, unique]
  email_verified_at timestamp
  password varchar(255) [not null]
  is_active boolean [not null, default: true]
  remember_token varchar(100)
  created_at timestamp
  updated_at timestamp
}

Table categories {
  id bigint [pk, increment]
  category_name varchar(100) [not null, unique]
  description text
  expiry_alert_days int [not null, default: 7, note: 'Days before expiry to flag a batch as near expiry']
  created_at timestamp
  updated_at timestamp
}

Table products {
  id bigint [pk, increment]
  category_id bigint [not null]
  product_name varchar(150) [not null]
  sku_code varchar(50) [not null, unique]
  unit_of_measure varchar(30) [not null]
  min_stock_level decimal(10,2) [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp
}

Table batches {
  id bigint [pk, increment]
  product_id bigint [not null]
  batch_number varchar(100) [not null]
  initial_quantity decimal(10,2) [not null]
  current_quantity decimal(10,2) [not null]
  manufacture_date date
  expiry_date date [note: 'Null for non-perishable items']
  status varchar(20) [not null, default: 'active', note: 'active, near_expiry, expired, depleted']
  created_at timestamp
  updated_at timestamp

  indexes {
    (product_id, batch_number) [unique]
    (product_id, expiry_date)
  }
}

Table stock_transactions {
  id bigint [pk, increment]
  batch_id bigint [not null]
  user_id bigint [not null]
  transaction_type varchar(50) [not null, note: 'received, used, adjustment']
  quantity_changed decimal(10,2) [not null, note: 'Signed: negative when stock is used']
  remarks text
  transaction_date timestamp [default: `now()`]
}

Table demand_forecasts {
  id bigint [pk, increment]
  product_id bigint [not null]
  forecast_date date [not null]
  predicted_demand_qty decimal(10,2) [not null]
  predicted_spoilage_qty decimal(10,2) [not null]
  recommended_reorder_qty decimal(10,2) [not null]
  confidence_score decimal(5,2)
  generated_at timestamp [default: `now()`]
}

Table alerts {
  id bigint [pk, increment]
  alert_type varchar(20) [not null, note: 'expired, near_expiry, low_stock']
  product_id bigint [not null]
  batch_id bigint [note: 'Null for low_stock alerts']
  message varchar(255) [not null]
  is_resolved boolean [not null, default: false]
  resolved_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (alert_type, product_id, batch_id, is_resolved)
    (is_resolved, created_at)
  }
}

Ref: users.role_id > roles.id
Ref: products.category_id > categories.id
Ref: batches.product_id > products.id
Ref: stock_transactions.batch_id > batches.id
Ref: stock_transactions.user_id > users.id
Ref: demand_forecasts.product_id > products.id
Ref: alerts.product_id > products.id
Ref: alerts.batch_id > batches.id
