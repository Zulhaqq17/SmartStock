# Copy this file to .env and adjust. NEVER commit .env
# (This one .env is all you need. You do NOT edit anything inside src/ for settings.)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=smartstock
MYSQL_USER=smartstock_user
MYSQL_PASSWORD=change_me_user

# Host ports (change if they clash with something on your machine)
WEB_PORT=8080
PMA_PORT=8081
DB_HOST_PORT=3307

# Laravel
APP_ENV=local
APP_DEBUG=true
